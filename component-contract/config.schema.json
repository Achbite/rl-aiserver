{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rl-training.local/schemas/aiserver-config.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "server", "contract", "policy", "observation", "strategy", "model",
    "environment", "task", "model_distribution", "sample_distributor",
    "metrics"
  ],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_mode", "listen_port", "max_agents"],
      "properties": {
        "run_mode": {"enum": ["training", "evaluation"]},
        "listen_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "max_agents": {"type": "integer", "minimum": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name", "package_version", "platform",
        "training_contract_path"
      ],
      "properties": {
        "package_name": {"type": "string", "minLength": 1},
        "package_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "training_contract_path": {"type": "string", "minLength": 1}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampling_seed"],
      "properties": {
        "sampling_seed": {"type": "integer", "minimum": 0}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ray_max_range"],
      "properties": {
        "ray_max_range": {"type": "integer", "minimum": 1}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_size", "replan_interval"],
      "properties": {
        "grid_size": {"type": "integer", "minimum": 1},
        "replan_interval": {"type": "integer", "minimum": 0}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_model_path", "local_train_dir", "startup_timeout_ms"],
      "properties": {
        "evaluation_model_path": {"type": "string", "minLength": 1},
        "local_train_dir": {"type": "string", "minLength": 1},
        "startup_timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_count"],
      "properties": {
        "agent_count": {"type": "integer", "minimum": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_protocol_id", "task_protocol_version", "fixed_map_id",
        "episode_max_steps"
      ],
      "properties": {
        "task_protocol_id": {"type": "string", "minLength": 1},
        "task_protocol_version": {"type": "integer", "minimum": 1},
        "fixed_map_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "episode_max_steps": {"type": "integer", "minimum": 1}
      }
    },
    "model_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "poll_interval_ms", "rpc_timeout_ms"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "poll_interval_ms": {"type": "integer", "minimum": 1},
        "rpc_timeout_ms": {"type": "integer", "minimum": 1}
      }
    },
    "sample_distributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "host", "port", "envelope_max_transitions",
        "envelope_max_bytes", "rpc_timeout_ms", "max_attempts",
        "enqueue_timeout_ms", "drain_timeout_ms", "health_timeout_ms",
        "status_poll_interval_ms", "recovery_timeout_ms",
        "outbound_max_envelopes", "outbound_max_estimated_bytes",
        "aiserver_id", "env_id"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "envelope_max_transitions": {"type": "integer", "minimum": 1},
        "envelope_max_bytes": {"type": "integer", "minimum": 1},
        "rpc_timeout_ms": {"type": "integer", "minimum": 1},
        "max_attempts": {"type": "integer", "minimum": 1},
        "enqueue_timeout_ms": {"type": "integer", "minimum": 1},
        "drain_timeout_ms": {"type": "integer", "minimum": 1},
        "health_timeout_ms": {"type": "integer", "minimum": 1},
        "status_poll_interval_ms": {"type": "integer", "minimum": 1},
        "recovery_timeout_ms": {"type": "integer", "minimum": 1},
        "outbound_max_envelopes": {"type": "integer", "minimum": 1},
        "outbound_max_estimated_bytes": {"type": "integer", "minimum": 1},
        "aiserver_id": {"type": "string", "minLength": 1},
        "env_id": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_schema_catalog"],
      "properties": {
        "event_schema_catalog": {"type": "string", "minLength": 1}
      }
    }
  }
}
