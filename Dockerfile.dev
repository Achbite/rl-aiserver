ARG CPP_DEV_BASE_IMAGE=python:3.11-slim
FROM ${CPP_DEV_BASE_IMAGE}

ARG ONNXRUNTIME_VERSION=1.17.0
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    ccache \
    cmake \
    git \
    libabsl-dev \
    libgrpc++-dev \
    libprotobuf-dev \
    libssl-dev \
    make \
    ninja-build \
    pkg-config \
    procps \
    protobuf-compiler \
    protobuf-compiler-grpc \
    wget \
    && rm -rf /var/lib/apt/lists/* && \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) ORT_ARCH="x64" ;; \
        arm64) ORT_ARCH="aarch64" ;; \
        *) exit 1 ;; \
    esac && \
    ORT_PACKAGE="onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}" && \
    wget -q "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/${ORT_PACKAGE}.tgz" && \
    tar xzf "${ORT_PACKAGE}.tgz" && \
    cp -R "${ORT_PACKAGE}"/include/* /usr/local/include/ && \
    cp "${ORT_PACKAGE}"/lib/* /usr/local/lib/ && \
    ldconfig && \
    rm -rf "${ORT_PACKAGE}" "${ORT_PACKAGE}.tgz"

RUN pip install --no-cache-dir protobuf==7.35.1

LABEL org.rl-training.dev-toolchain="cpp17-debian13-onnxruntime-1.17.0"
WORKDIR /workspace/rl-aiserver
ENTRYPOINT []
CMD ["sleep", "infinity"]
