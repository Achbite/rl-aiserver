#!/usr/bin/env python3
"""Generate the C++ SDK type binding from protoc's service descriptors."""

import sys

from google.protobuf.compiler import plugin_pb2


def cpp_type(proto_type: str) -> str:
    return "::" + proto_type.lstrip(".").replace(".", "::")


def generate(request: plugin_pb2.CodeGeneratorRequest) -> plugin_pb2.CodeGeneratorResponse:
    response = plugin_pb2.CodeGeneratorResponse()
    response.supported_features = plugin_pb2.CodeGeneratorResponse.FEATURE_PROTO3_OPTIONAL
    selected = set(request.file_to_generate)
    for descriptor in request.proto_file:
        if descriptor.name not in selected or not descriptor.service:
            continue
        stem = descriptor.name.removesuffix(".proto")
        namespace = descriptor.package.replace(".", "::")
        lines = [
            "// Generated by protoc-gen-rl-sdk. DO NOT EDIT.",
            f"// Source: {descriptor.name}",
            "#pragma once",
            "",
            f'#include "{stem}.grpc.pb.h"',
            "",
        ]
        if namespace:
            lines += [f"namespace {namespace} {{", ""]
        for service in descriptor.service:
            service_type = cpp_type(".".join(filter(None, [descriptor.package, service.name])))
            lines += [f"struct {service.name}Protocol {{", f"    using Service = {service_type};"]
            for method in service.method:
                lines += [
                    f"    using {method.name}Req = {cpp_type(method.input_type)};",
                    f"    using {method.name}Rsp = {cpp_type(method.output_type)};",
                ]
            lines += ["};", ""]
        if namespace:
            lines += [f"}}  // namespace {namespace}", ""]
        output = response.file.add()
        output.name = f"{stem}.sdk.pb.h"
        output.content = "\n".join(lines)
    return response


if __name__ == "__main__":
    request = plugin_pb2.CodeGeneratorRequest.FromString(sys.stdin.buffer.read())
    sys.stdout.buffer.write(generate(request).SerializeToString())
