#!/usr/bin/env python3
"""Compile a local task Proto and its import closure with the public RL-SDK."""

import argparse
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tempfile

from google.protobuf import descriptor_pb2


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--task-proto", required=True)
    parser.add_argument("--sdk-root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--import-dir", action="append", type=Path, default=[])
    parser.add_argument("--output-dir", required=True, type=Path)
    parser.add_argument("--protoc", default="protoc")
    parser.add_argument("--grpc-plugin", default="grpc_cpp_plugin")
    parser.add_argument("--describe", action="store_true")
    args = parser.parse_args()
    sdk_root = args.sdk_root.resolve()
    roots = [sdk_root, *(path.resolve() for path in args.import_dir)]
    task = Path(args.task_proto)
    if task.is_absolute():
        for root in roots:
            try:
                task = task.resolve().relative_to(root)
                break
            except ValueError:
                continue
        else:
            parser.error("task Proto must be inside an import directory")
    includes = [f"--proto_path={root}" for root in roots]
    with tempfile.TemporaryDirectory(prefix="rl-sdk-descriptor-") as temporary:
        descriptor_path = Path(temporary) / "task.pb"
        subprocess.run([args.protoc, *includes, "--include_imports",
                        f"--descriptor_set_out={descriptor_path}", str(task),
                        "proto/common/identity.proto", "proto/communication/session.proto"], check=True)
        descriptor_set = descriptor_pb2.FileDescriptorSet.FromString(descriptor_path.read_bytes())
    # Well-known Protobuf messages are supplied by libprotobuf itself.
    files = [item for item in descriptor_set.file if not item.name.startswith("google/protobuf/")]
    names = [item.name for item in files]
    services = [item.name for item in files if item.service]
    if args.describe:
        for item in files:
            source = next(root / item.name for root in roots if (root / item.name).is_file())
            print(f"input:{source}")
            print(f"cpp:{item.name.removesuffix('.proto')}")
            if item.service:
                print(f"service:{item.name.removesuffix('.proto')}")
        return
    args.output_dir.mkdir(parents=True, exist_ok=True)
    subprocess.run([args.protoc, *includes, f"--cpp_out={args.output_dir}", *names], check=True)
    if services:
        grpc_plugin = shutil.which(args.grpc_plugin)
        if grpc_plugin is None:
            parser.error(f"gRPC C++ generator is unavailable: {args.grpc_plugin}")
        with tempfile.TemporaryDirectory(prefix="rl-sdk-plugin-") as temporary:
            launcher = Path(temporary) / "protoc-gen-rl-sdk"
            command = shlex.join([sys.executable, str(sdk_root / "tools/protoc-gen-rl-sdk")])
            launcher.write_text(f'#!/bin/sh\nexec {command} "$@"\n', encoding="utf-8")
            launcher.chmod(0o700)
            subprocess.run([args.protoc, *includes, f"--grpc_out={args.output_dir}",
                            f"--plugin=protoc-gen-grpc={grpc_plugin}",
                            f"--plugin=protoc-gen-rl_sdk={launcher}",
                            f"--rl_sdk_out={args.output_dir}", *services], check=True)


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        sys.exit(error.returncode)
